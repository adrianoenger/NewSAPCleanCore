# Copy to `.env` and adjust locally. Never commit `.env` or real credentials.

# --- PostgreSQL (Docker Compose) ---
CCA_POSTGRES_DB=cleancore
CCA_POSTGRES_USER=cleancore
CCA_POSTGRES_PASSWORD=cleancore
CCA_POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
CCA_BACKEND_PORT=8000
CCA_ENVIRONMENT=development
# JSON list of renderer origins allowed by CORS ("null" = packaged Electron file://).
# CCA_CORS_ORIGINS=["http://localhost:5173","null"]

# --- Frontend (Electron/React on host) ---
# Backend URL used by the desktop shell.
VITE_CCA_BACKEND_URL=http://localhost:8000

# --- LLM providers (SPRINT-09 / ADR-006) ---
# AWS Bedrock: resolved by boto3 from the host's mounted ~/.aws (see compose.yml) — set the
# profile name here, never a static access key/secret.
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# CCA_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Azure AI Foundry: leave empty until credentials are available (live validation deferred).
# CCA_AZURE_FOUNDRY_ENDPOINT=
# CCA_AZURE_FOUNDRY_API_KEY=
# CCA_AZURE_FOUNDRY_DEPLOYMENT=

# --- SAP knowledge via MCP (SPRINT-12 / ADR-007) ---
# Local Docker mcp-sap-docs / mcp-abap streamable-HTTP endpoints. Leave empty to skip enrichment
# (each provider is optional — the rest of the application stays runnable without either).
# CCA_SAP_DOCS_MCP_ENDPOINT=http://localhost:39301/mcp
# CCA_SAP_DOCS_MCP_TOOL_NAME=search
# CCA_ABAP_MCP_ENDPOINT=http://localhost:39302/mcp
# CCA_ABAP_MCP_TOOL_NAME=search
