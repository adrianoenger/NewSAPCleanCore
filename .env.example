# Copy to `.env` and adjust locally. Never commit `.env` or real credentials.

# --- PostgreSQL (Docker Compose) ---
CCA_POSTGRES_DB=cleancore
CCA_POSTGRES_USER=cleancore
CCA_POSTGRES_PASSWORD=cleancore
CCA_POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
CCA_BACKEND_PORT=8000
CCA_ENVIRONMENT=development
# JSON list of renderer origins allowed by CORS ("null" = packaged Electron file://).
# CCA_CORS_ORIGINS=["http://localhost:5173","null"]

# --- Frontend (Electron/React on host) ---
# Backend URL used by the desktop shell.
VITE_CCA_BACKEND_URL=http://localhost:8000

# --- LLM providers (introduced in later sprints; leave empty) ---
# AWS_REGION=
# AZURE_AI_FOUNDRY_ENDPOINT=
